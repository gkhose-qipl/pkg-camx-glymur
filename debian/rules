#!/usr/bin/make -f

%:
	dh $@

override_dh_strip:
	# Don't strip DSP skel files
	dh_strip --exclude=libhme_dsp_skel.so

maintainerclean:
	rm -r \
		LICENSE.qcom-2 \
		camx-entitled-headers-dev \
		camx-glymur \
		camx-glymur-dbgsym \
		camx-glymur-dev \
		libcamx-dev \
		libcamx-glymur-dev \
		libcamx-glymur1 \
		libcamx-glymur1-dbgsym
